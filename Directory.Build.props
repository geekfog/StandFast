<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Product>StandFast</Product>
    <Company>StandFast</Company>
    <!-- Single source of truth for the application version as MM.mm.pp (Major.Minor.PatchNumber) -->
    <VersionPrefix>01.03.00</VersionPrefix>
    <!-- Single source of truth for the app's icon artwork: one file per format under media, each named after the product -->
    <BrandingDirectory>$(MSBuildThisFileDirectory)media\</BrandingDirectory>
    <BrandingIconSvg>$(BrandingDirectory)$(Product).svg</BrandingIconSvg>
    <BrandingIconPng>$(BrandingDirectory)$(Product).png</BrandingIconPng>
    <BrandingIconIco>$(BrandingDirectory)$(Product).ico</BrandingIconIco>
  </PropertyGroup>

</Project>
