@using System.Security.Claims
@inherits LayoutComponentBase
@inject IUserPreferencesService PreferencesService

<MudThemeProvider @bind-IsDarkMode="isDarkMode" Theme="StandFastTheme.Default" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="ToggleDrawer" aria-label="Toggle navigation" />
        <MudText Typo="Typo.h6" Class="ml-2">@AppInfo.Name</MudText>
        <MudText Typo="Typo.caption" Class="ml-3 d-none d-sm-flex">@AppInfo.Tagline</MudText>
        <MudSpacer />
        <MudIconButton Icon="@(isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)" Color="Color.Inherit" OnClick="ToggleDarkMode" aria-label="Toggle dark mode" />
        <AuthorizeView>
            <Authorized>
                <MudMenu Icon="@Icons.Material.Filled.AccountCircle" Color="Color.Inherit" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                    <MudText Typo="Typo.body2" Class="px-4 py-2">@context.User.Identity?.Name</MudText>
                    <MudDivider />
                    <MudMenuItem Href="@UiRoutes.SignOut" Icon="@Icons.Material.Filled.Logout">Sign out</MudMenuItem>
                </MudMenu>
            </Authorized>
            <NotAuthorized>
                <MudButton Href="@UiRoutes.SignIn" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Login">Sign in</MudButton>
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>

    <MudDrawer @bind-Open="drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="1" Variant="DrawerVariant.Mini" OpenMiniOnHover="true">
        <NavMenu />
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="my-4">
            @* Every page is shown the signed-in user's settings from the one load the layout does, so no screen fetches them again to mark its own rows. *@
            <CascadingValue Value="preferences">
                @Body
            </CascadingValue>
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    /// <summary>
    /// The signed-in principal, which is how the layout knows whose settings to load. It comes from the cascading authentication state rather than
    /// from <c>ICurrentUser</c> because the layout also runs inside an interactive circuit, where there is no HTTP context to read a principal from.
    /// </summary>
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private UserPreferencesDto preferences = UserPreferencesDto.Default;
    private bool drawerOpen = true;
    private bool isDarkMode = UserPreferencesDto.Default.IsDarkMode;
    private string? userId;

    /// <summary>
    /// Settings are loaded on the prerender as well as on the circuit, so the first painted HTML already carries the user's own theme and the page
    /// does not start light and then switch.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        string? email = null;

        if (AuthenticationStateTask is not null)
        {
            ClaimsPrincipal user = (await AuthenticationStateTask).User;
            userId = user.UserId();
            email = user.Email();
        }

        preferences = await PreferencesService.LoadAsync(userId, email);
        isDarkMode = preferences.IsDarkMode;
    }

    private void ToggleDrawer() => drawerOpen = !drawerOpen;

    private async Task ToggleDarkMode()
    {
        isDarkMode = !isDarkMode;
        preferences = preferences with { IsDarkMode = isDarkMode };

        await PreferencesService.SetDarkModeAsync(userId, isDarkMode);
    }
}
