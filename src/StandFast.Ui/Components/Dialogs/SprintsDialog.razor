@using StandFast.Application.Mapping
@inject ISprintService SprintService
@inject IDialogService DialogService
@inject FluentValidation.IValidator<SprintEditDto> Validator

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@CalendarLabels.Sprints for @StandupName</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="form" Model="edit" Validation="@FluentValidationAdapter.ForField(Validator)">
            <MudGrid Spacing="3" Class="mb-3">
                <MudItem xs="12" sm="4">
                    <MudTextField @bind-Value="edit.Name" For="@(() => edit.Name)" Label="Name" Placeholder="Sprint 29" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="5">
                    <MudDateRangePicker DateRange="@Dates" DateRangeChanged="OnDatesChanged" Label="Dates" DateFormat="@UiFormats.ShortDate" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="3" Class="d-flex align-center gap-1">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="isSaving" OnClick="SaveAsync">@(edit.Id is null ? "Add" : "Save")</MudButton>
                    @if (edit.Id is not null)
                    {
                        <MudButton OnClick="StartNew">Cancel</MudButton>
                    }
                </MudItem>
            </MudGrid>
        </MudForm>

        @if (saveError is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@saveError</MudAlert>
        }

        <MudTable Items="sprints" Hover="true" Dense="true" Loading="isLoading" Elevation="0">
            <HeaderContent>
                <MudTh>Name</MudTh>
                <MudTh>Dates</MudTh>
                <MudTh Style="width: 7rem;"></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Name">@context.Name</MudTd>
                <MudTd DataLabel="Dates">@CalendarLabels.Range(context.StartDate, context.EndDate)</MudTd>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => StartEdit(context))" aria-label="@($"Edit {context.Name}")" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteAsync(context))" aria-label="@($"Delete {context.Name}")" />
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>No sprints recorded for this standup yet.</NoRecordsContent>
        </MudTable>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private MudForm form = default!;
    private IReadOnlyList<SprintDto> sprints = [];
    private SprintEditDto edit = new();
    private bool isLoading = true;
    private bool isSaving;

    /// <summary>Set when saving was refused, including for an overlap with another sprint, which only the stored sprints can show.</summary>
    private string? saveError;

    [CascadingParameter]
    private IMudDialogInstance Dialog { get; set; } = default!;

    [Parameter]
    [EditorRequired]
    public Guid StandupId { get; set; }

    [Parameter]
    [EditorRequired]
    public string StandupName { get; set; } = string.Empty;

    private MudBlazor.DateRange Dates => new(edit.StartDate.ToPickerDate(), edit.EndDate.ToPickerDate());

    protected override async Task OnInitializedAsync()
    {
        StartNew();
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        isLoading = true;
        sprints = await SprintService.GetForStandupAsync(StandupId);
        isLoading = false;
    }

    private void OnDatesChanged(MudBlazor.DateRange? dates)
    {
        edit.StartDate = dates?.Start.FromPickerDate();
        edit.EndDate = dates?.End.FromPickerDate();
        saveError = null;
    }

    private void StartNew()
    {
        edit = new SprintEditDto { StandupId = StandupId };
        saveError = null;
    }

    private void StartEdit(SprintDto sprint)
    {
        edit = sprint.ToEditDto();
        saveError = null;
    }

    private async Task SaveAsync()
    {
        await form.ValidateAsync();
        if (!form.IsValid)
        {
            return;
        }

        isSaving = true;

        try
        {
            await SprintService.SaveAsync(edit);
            StartNew();
            await ReloadAsync();
        }
        catch (FluentValidation.ValidationException exception)
        {
            saveError = exception.Describe();
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeleteAsync(SprintDto sprint)
    {
        bool? confirmed = await DialogService.ShowMessageBoxAsync("Remove sprint", $"Remove {sprint.Name}?", yesText: "Remove", cancelText: "Cancel");
        if (confirmed == true)
        {
            await SprintService.DeleteAsync(StandupId, sprint.Id);
            StartNew();
            await ReloadAsync();
        }
    }

    private void Close() => Dialog.Close(DialogResult.Ok(true));
}
