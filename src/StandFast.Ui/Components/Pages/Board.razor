@page "/"
@page "/board"
@attribute [Authorize]

<PageTitle>@AppInfo.PageTitle("Board")</PageTitle>

<div class="standfast-board">
    <div class="standfast-board-header">
        @*
            Two rows that line up across both columns: the Lock button and sprint beside the date, then the standup and leader pickers beside the week strip,
            centered on it. Below the md breakpoint each area stacks, the pickers under the Lock button and the date over the week strip.
        *@
        <div class="standfast-board-header-grid">
            <div class="standfast-board-header-tools d-flex align-center flex-wrap gap-3">
                @if (board is not null)
                {
                    <MudTooltip Text="@LockActionDescription">
                        <MudButton Variant="Variant.Outlined"
                                   Size="Size.Small"
                                   Color="@StandFastTheme.LockColor(IsLocked)"
                                   StartIcon="@StandFastTheme.LockIcon(IsLocked)"
                                   Disabled="@(!IsLocked && !HasPresented)"
                                   OnClick="ToggleLockAsync"
                                   aria-label="@LockActionDescription">
                            @(IsLocked ? "Unlock" : "Lock")
                        </MudButton>
                    </MudTooltip>
                }
                @if (board?.Sprint is { } sprint)
                {
                    <div class="d-flex align-center gap-1">
                        <MudTooltip Text="@CalendarLabels.SprintDescription(sprint)" RootClass="d-flex">
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" Icon="@CalendarLabels.SprintIcon" Class="ma-0">@CalendarLabels.SprintCaption(sprint)</MudChip>
                        </MudTooltip>
                        @if (sprint.Note is { } note)
                        {
                            <MudTooltip Text="@note" RootClass="d-flex">
                                <MudIcon Icon="@CalendarLabels.SprintNoteIcon" Size="Size.Small" Color="Color.Warning" aria-label="@note" />
                            </MudTooltip>
                        }
                    </div>
                }
            </div>
            <div class="standfast-board-header-date">
                @if (standups.Count == 0)
                {
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
                        No standups defined yet. <MudLink Href="@UiRoutes.Standups">Create one</MudLink> and add people to its roster.
                    </MudAlert>
                }
                else if (board is null)
                {
                    <MudProgressLinear Indeterminate="true" Class="mb-2" />
                }
                else
                {
                    @if (!board.IsScheduledDay)
                    {
                        <MudAlert Severity="Severity.Normal" Dense="true" Class="mb-2">@board.StandupName does not normally run on this day.</MudAlert>
                    }
                }
                <h1 class="mud-typography mud-typography-h6 standfast-board-date">
                    @SelectedDate.ToDateTime(TimeOnly.MinValue).ToString(UiFormats.LongDate)
                    <MudTooltip Text="@DisplayTimeZoneDescription">
                        <span class="mud-typography-body2 mud-text-secondary" aria-label="@DisplayTimeZoneDescription">@DisplayTimeZoneLabel</span>
                    </MudTooltip>
                </h1>
            </div>
            <div class="standfast-board-header-pickers">
                <MudGrid Spacing="3">
                    <MudItem xs="12" sm="6">
                        <MudSelect T="Guid" Value="@standupPickerValue" ValueChanged="OnStandupChangedAsync" Label="Standup" Variant="Variant.Outlined" Dense="true" Class="mb-0" Disabled="@(standups.Count == 0)">
                            @foreach (StandupDto standup in standups)
                            {
                                <MudSelectItem T="Guid" Value="@standup.Id">@standup.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        @* Only someone who is here can run the standup, so the picker offers attending leaders, and everyone attending once the toggle opens it up for the date. *@
                        <div class="d-flex align-center gap-1">
                            <MudTooltip Text="@LeaderEmptyReason" Disabled="@(LeaderEmptyReason is null)" Inline="false" RootClass="flex-grow-1">
                                <MudSelect T="Guid?" Value="@board?.LeaderPersonId" ValueChanged="OnLeaderChangedAsync" Label="@RosterLabels.Name(RosterRole.Leader)" Variant="Variant.Outlined" Dense="true" Class="mb-0" Clearable="true"
                                           Disabled="@(LeaderCandidates.Count == 0 || IsLocked)">
                                    @foreach (StandupMemberDto leader in LeaderCandidates)
                                    {
                                        <MudSelectItem T="Guid?" Value="@leader.PersonId">@leader.DisplayName</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudTooltip>
                            <MudTooltip Text="@LeaderPoolDescription">
                                <MudToggleIconButton Toggled="@AnyAttendeeCanLead" ToggledChanged="OnAnyAttendeeCanLeadChangedAsync"
                                                     Icon="@Icons.Material.Outlined.GroupAdd" ToggledIcon="@Icons.Material.Filled.GroupAdd" ToggledColor="Color.Primary"
                                                     Disabled="@(board is null || IsLocked)" aria-label="@LeaderPoolDescription" />
                            </MudTooltip>
                        </div>
                    </MudItem>
                </MudGrid>
            </div>
            <div class="standfast-board-header-strip">
                <WeekStrip SelectedDate="@SelectedDate" SelectedDateChanged="OnDateChangedAsync" Today="@today" ScheduledDays="@SelectedStandupDays"
                           PresentedDates="@presentedDates" LockedDates="@lockedDates" />
            </div>
        </div>
    </div>

    @if (standups.Count > 0 && board is not null)
    {
        <div class="standfast-board-body">
            <MudGrid Spacing="3" Class="mt-1">
                @foreach (AttendanceState[] column in BoardColumns)
                {
                    <MudItem xs="12" md="4">
                        <MudPaper Outlined="true" Class="pa-3 standfast-column">
                            @foreach (AttendanceState state in column)
                            {
                                <div class="@($"standfast-column-header d-flex align-center mb-2 {(state == column[0] ? string.Empty : "mt-4")}")"
                                     style="@($"--standfast-column-color: {StandFastTheme.ColumnCssColor(state)}")">
                                    <MudIcon Icon="@StandFastTheme.ColumnIcon(state)" Class="mr-2" />
                                    <MudText Typo="Typo.subtitle1" Class="flex-grow-1">@StandFastTheme.ColumnTitle(state)</MudText>
                                    @if (state == AttendanceState.Roster)
                                    {
                                        @* The filter decides who the roster lists, and so whether a tap lands them in Present, Leaders, or Guests. *@
                                        <MudToggleGroup T="AttendeeKind?" @bind-Value="rosterView" Size="Size.Small" Color="Color.Primary" Class="mr-2 standfast-roster-filter" aria-label="Show on the roster">
                                            @foreach (AttendeeKind? kind in RosterViews)
                                            {
                                                @* Each kind shows the icon its roster cards carry, named on hover, which keeps the filter narrow enough to share the header. *@
                                                <MudToggleItem T="AttendeeKind?" Value="@kind">
                                                    @if (kind is { } attendeeKind)
                                                    {
                                                        <MudTooltip Text="@RosterLabels.Plural(attendeeKind)" RootClass="d-flex">
                                                            <MudIcon Icon="@StandFastTheme.KindIcon(attendeeKind)" Size="Size.Small" aria-label="@RosterLabels.Plural(attendeeKind)" />
                                                        </MudTooltip>
                                                    }
                                                    else
                                                    {
                                                        @RosterLabels.AllRosters
                                                    }
                                                </MudToggleItem>
                                            }
                                        </MudToggleGroup>
                                    }
                                    <MudChip T="string" Size="Size.Small" Class="standfast-column-count">@ParticipantsIn(state).Count</MudChip>
                                </div>

                                @foreach (BoardParticipantDto participant in ParticipantsIn(state))
                                {
                                    <ParticipantCard Participant="@participant"
                                                     TimeZone="@DisplayTimeZone"
                                                     TimeZoneLabel="@DisplayTimeZoneLabel"
                                                     MeetingStart="@MeetingStart"
                                                     MeetingDate="@SelectedDate"
                                                     PriorTurn="@board.PriorTurnFor(participant.PersonId)"
                                                     Availability="@board.AvailabilityFor(participant.PersonId)"
                                                     Sprint="@board.Sprint"
                                                     ShowPriorTurn="@(state == AttendanceState.Available)"
                                                     IsSelected="@(participant.PersonId == selectedPersonId)"
                                                     IsSelf="@Preferences.IsSelf(participant.Email)"
                                                     IsLocked="@IsLocked"
                                                     OnAdvance="AdvanceAsync"
                                                     OnRevert="RevertAsync"
                                                     OnSelect="SelectParticipantAsync" />
                                }

                                @if (ParticipantsIn(state).Count == 0)
                                {
                                    <MudText Typo="Typo.body2" Class="mud-text-secondary">@EmptyColumnText(state)</MudText>
                                }
                            }
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>
        </div>

        @if (SelectedParticipant is { } participant)
        {
            @* The date comes from the loaded board rather than the URL, so while a new date loads the panel keeps the date its participant belongs to. *@
            <div class="standfast-board-footer standfast-update-dock">
                <ParticipantUpdatePanel @ref="updatePanel"
                                        Participant="@participant"
                                        StandupId="@SelectedStandupId"
                                        MeetingDate="@board.MeetingDate"
                                        TimeZone="@DisplayTimeZone"
                                        IsReadOnly="@IsLocked"
                                        OnSave="SaveUpdateAsync"
                                        OnClose="CloseUpdate" />
            </div>
        }
        else if (board.Participants.Count > 0)
        {
            <div class="standfast-board-footer">
                <MudAlert Severity="Severity.Normal" Dense="true" Icon="@StandFastTheme.UpdateIcon">@UpdateHintText</MudAlert>
            </div>
        }
    }
</div>
