@page "/people"
@attribute [Authorize]
@inject IPersonService PersonService
@inject IStandupService StandupService
@inject IDialogService DialogService

<PageTitle>@AppInfo.PageTitle("People")</PageTitle>

<div class="d-flex align-center mb-4">
    <h1 class="mud-typography mud-typography-h5 flex-grow-1">People</h1>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="@(() => EditAsync(null))">Add person</MudButton>
</div>

<MudTable Items="people" Hover="true" Dense="true" Loading="isLoading" Elevation="1">
    <HeaderContent>
        <MudTh>Name</MudTh>
        <MudTh>Email</MudTh>
        <MudTh>Standups</MudTh>
        <MudTh>Status</MudTh>
        <MudTh Style="width: 7rem;"></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Name">
            @context.DisplayName
            @if (context.HasDisplayOverride)
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary ml-1">(@context.FullName)</MudText>
            }
            @if (context.HasNotes)
            {
                <MudTooltip Text="Has notes">
                    <MudIcon Icon="@Icons.Material.Filled.StickyNote2" Size="Size.Small" Class="ml-1" />
                </MudTooltip>
            }
        </MudTd>
        <MudTd DataLabel="Email">@context.Email</MudTd>
        <MudTd DataLabel="Standups">
            @foreach (string standupName in StandupsFor(context.Id))
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="ma-1">@standupName</MudChip>
            }
            @if (StandupsFor(context.Id).Count == 0)
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary">None</MudText>
            }
        </MudTd>
        <MudTd DataLabel="Status">
            <MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">@(context.IsActive ? "Active" : "Inactive")</MudChip>
        </MudTd>
        <MudTd>
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => EditAsync(context))" aria-label="@($"Edit {context.DisplayName}")" />
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteAsync(context))" aria-label="@($"Delete {context.DisplayName}")" />
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>No people defined yet.</NoRecordsContent>
</MudTable>

@code {
    private static readonly IReadOnlyList<string> NoStandups = [];

    private IReadOnlyList<PersonDto> people = [];
    private IReadOnlyDictionary<Guid, IReadOnlyList<string>> standupsByPerson = new Dictionary<Guid, IReadOnlyList<string>>();
    private bool isLoading = true;

    protected override Task OnInitializedAsync() => ReloadAsync();

    private IReadOnlyList<string> StandupsFor(Guid personId) => standupsByPerson.GetValueOrDefault(personId, NoStandups);

    private async Task ReloadAsync()
    {
        isLoading = true;

        Task<IReadOnlyList<PersonDto>> peopleTask = PersonService.GetAllAsync();
        Task<IReadOnlyDictionary<Guid, IReadOnlyList<string>>> assignmentsTask = StandupService.GetStandupNamesByPersonAsync();
        await Task.WhenAll(peopleTask, assignmentsTask);

        people = peopleTask.Result;
        standupsByPerson = assignmentsTask.Result;
        isLoading = false;
    }

    private async Task EditAsync(PersonDto? person)
    {
        // Existing people are re-fetched as an edit DTO so the entity-to-DTO mapping stays in the Application layer rather than being repeated here.
        PersonEditDto edit = person is null ? new PersonEditDto() : await PersonService.GetForEditAsync(person.Id) ?? new PersonEditDto();

        DialogParameters<PersonDialog> parameters = new() { { dialog => dialog.Person, edit } };

        // Wider than the default, because the dialog carries a markdown editor with its own toolbar.
        DialogOptions options = new() { MaxWidth = MaxWidth.Medium, FullWidth = true };
        IDialogReference reference = await DialogService.ShowAsync<PersonDialog>(null, parameters, options);

        if (!(await reference.Result)!.Canceled)
        {
            await ReloadAsync();
        }
    }

    private async Task DeleteAsync(PersonDto person)
    {
        bool? confirmed = await DialogService.ShowMessageBoxAsync("Remove person", $"Remove {person.DisplayName} from the directory? Their past standup entries are kept.", yesText: "Remove", cancelText: "Cancel");
        if (confirmed == true)
        {
            await PersonService.DeleteAsync(person.Id);
            await ReloadAsync();
        }
    }
}
