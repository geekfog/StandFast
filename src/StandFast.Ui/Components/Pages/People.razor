@page "/people"
@attribute [Authorize]
@inject IPersonService PersonService
@inject IStandupService StandupService
@inject IDialogService DialogService

<PageTitle>@AppInfo.PageTitle("People")</PageTitle>

<div class="d-flex align-center mb-4">
    <h1 class="mud-typography mud-typography-h5 flex-grow-1">People</h1>
    @* No chip selected lists everyone; each selected chip adds the people it matches. *@
    <MudPaper Outlined="true" Class="d-flex align-center pl-3 pr-1 mr-4" role="group" aria-label="@PersonLabels.RoleFilter">
        <MudText Typo="Typo.body2" Class="mud-text-secondary mr-2">@PersonLabels.RoleFilter</MudText>
        <MudChipSet T="RosterFilter" @bind-SelectedValues="selectedFilters" SelectionMode="SelectionMode.MultiSelection" CheckMark="true" Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small">
            @foreach (RosterFilter filter in RosterFilters)
            {
                <MudChip T="RosterFilter" Value="@filter" Text="@filter.Label" />
            }
        </MudChipSet>
    </MudPaper>
    <MudSwitch @bind-Value="showInactive" Color="Color.Primary" Label="Show inactive" Class="mr-4" />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="@(() => EditAsync(null))">Add person</MudButton>
</div>

<MudTable Items="ShownPeople" Hover="true" Dense="true" Loading="isLoading" Elevation="1">
    <HeaderContent>
        <MudTh>Name</MudTh>
        <MudTh>@PersonLabels.Title</MudTh>
        <MudTh>@PersonLabels.Email</MudTh>
        <MudTh>Location</MudTh>
        <MudTh>@PersonLabels.StartDate</MudTh>
        @foreach (RosterRole role in RosterRoleExtensions.InDisplayOrder)
        {
            <MudTh>@RosterLabels.Plural(role)</MudTh>
        }
        <MudTh>Status</MudTh>
        <MudTh Style="width: 10rem;"></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Name">
            <div class="d-flex align-center">
                <PersonAvatar Initials="@context.Initials" PhotoUrl="@PersonPhotoUrls.Saved(context.Id, context.PhotoSavedUtc)" Class="mr-3" />
                @context.DisplayName
                @if (context.HasDisplayOverride)
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary ml-1">(@context.FullName)</MudText>
                }
                @if (context.HasNotes)
                {
                    <MudTooltip Text="Has notes">
                        <MudIcon Icon="@Icons.Material.Filled.StickyNote2" Size="Size.Small" Class="ml-1" />
                    </MudTooltip>
                }
            </div>
        </MudTd>
        <MudTd DataLabel="@PersonLabels.Title">@context.Title</MudTd>
        <MudTd DataLabel="@PersonLabels.Email">@context.Email</MudTd>
        <MudTd DataLabel="Location">
            @context.Location
            @if (context.TimeZoneId is not null)
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">@TimeZoneIds.DisplayName(context.TimeZoneId)</MudText>
            }
        </MudTd>
        <MudTd DataLabel="@PersonLabels.StartDate">@context.StartDate?.ToString(UiFormats.ShortDate)</MudTd>
        @foreach (RosterRole role in RosterRoleExtensions.InDisplayOrder)
        {
            <MudTd DataLabel="@RosterLabels.Plural(role)">
                @foreach (string standupName in standupNames.For(role, context.Id))
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="ma-1">@standupName</MudChip>
                }
                @if (standupNames.For(role, context.Id).Count == 0)
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">None</MudText>
                }
            </MudTd>
        }
        <MudTd DataLabel="Status">
            <MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">@PersonLabels.Status(context.IsActive)</MudChip>
        </MudTd>
        <MudTd>
            <MudTooltip Text="@CalendarLabels.DaysOff">
                <MudIconButton Icon="@CalendarLabels.DaysOffIcon" Size="Size.Small" OnClick="@(() => ManageDaysOffAsync(context))" aria-label="@($"{CalendarLabels.DaysOff} for {context.DisplayName}")" />
            </MudTooltip>
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => EditAsync(context))" aria-label="@($"Edit {context.DisplayName}")" />
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteAsync(context))" aria-label="@($"Delete {context.DisplayName}")" />
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>@(people.Count == 0 ? "No people defined yet." : $"Nobody {(showInactive ? "inactive" : "active")} matches the filter.")</NoRecordsContent>
</MudTable>

@code {
    private IReadOnlyList<PersonDto> people = [];
    private StandupNamesByPersonDto standupNames = StandupNamesByPersonDto.Empty;
    private bool isLoading = true;
    private bool showInactive;

    private IReadOnlyCollection<RosterFilter> selectedFilters = [];

    /// <summary>One chip per roster role, matching anyone on that roster of any standup, then one matching people on no roster at all.</summary>
    private static readonly IReadOnlyList<RosterFilter> RosterFilters =
    [
        .. RosterRoleExtensions.InDisplayOrder.Select(role => new RosterFilter(RosterLabels.Plural(role), roles => roles.Contains(role))),
        new RosterFilter("Neither", roles => roles.Count == 0),
    ];

    /// <summary>Active people, or only inactive ones while Show inactive is on, narrowed to those matching any selected roster filter.</summary>
    private IEnumerable<PersonDto> ShownPeople => people.Where(person => person.IsActive != showInactive
        && (selectedFilters.Count == 0 || selectedFilters.Any(filter => filter.Matches(standupNames.RolesFor(person.Id)))));

    private sealed record RosterFilter(string Label, Func<IReadOnlyList<RosterRole>, bool> Matches);

    protected override Task OnInitializedAsync() => ReloadAsync();

    private async Task ReloadAsync()
    {
        isLoading = true;

        Task<IReadOnlyList<PersonDto>> peopleTask = PersonService.GetAllAsync();
        Task<StandupNamesByPersonDto> assignmentsTask = StandupService.GetStandupNamesByPersonAsync();
        await Task.WhenAll(peopleTask, assignmentsTask);

        people = peopleTask.Result;
        standupNames = assignmentsTask.Result;
        isLoading = false;
    }

    private async Task EditAsync(PersonDto? person)
    {
        // Existing people are re-fetched as an edit DTO so the entity-to-DTO mapping stays in the Application layer rather than being repeated here.
        PersonEditDto edit = person is null ? new PersonEditDto() : await PersonService.GetForEditAsync(person.Id) ?? new PersonEditDto();

        DialogParameters<PersonDialog> parameters = new() { { dialog => dialog.Person, edit }, { dialog => dialog.People, people } };

        // Wider than the default, because the dialog carries a markdown editor with its own toolbar.
        DialogOptions options = new() { MaxWidth = MaxWidth.Medium, FullWidth = true };
        IDialogReference reference = await DialogService.ShowAsync<PersonDialog>(null, parameters, options);

        if (!(await reference.Result)!.Canceled)
        {
            await ReloadAsync();
        }
    }

    private async Task ManageDaysOffAsync(PersonDto person)
    {
        DialogParameters<DaysOffDialog> parameters = new() { { dialog => dialog.PersonId, person.Id }, { dialog => dialog.PersonName, person.DisplayName } };
        await DialogService.ShowAsync<DaysOffDialog>(null, parameters, new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
    }

    private async Task DeleteAsync(PersonDto person)
    {
        bool? confirmed = await DialogService.ShowMessageBoxAsync("Remove person", $"Remove {person.DisplayName} from the directory, along with their days off? Their past standup entries are kept.", yesText: "Remove", cancelText: "Cancel");
        if (confirmed == true)
        {
            await PersonService.DeleteAsync(person.Id);
            await ReloadAsync();
        }
    }
}
