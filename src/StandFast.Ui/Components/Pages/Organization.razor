@page "/organization"
@attribute [Authorize]
@inject IHolidayService HolidayService
@inject IDialogService DialogService
@using StandFast.Application.Mapping
@using StandFast.Domain.Abstractions
@inject IClock Clock
@inject Microsoft.Extensions.Options.IOptions<StandFastUiOptions> UiOptions

<PageTitle>@AppInfo.PageTitle(CalendarLabels.Organization)</PageTitle>

<h1 class="mud-typography mud-typography-h5 mb-4">@CalendarLabels.Organization</h1>

<MudTabs Outlined="true" Rounded="true" TabPanelsClass="pa-4">
    <MudTabPanel Text="@CalendarLabels.Holidays" Icon="@CalendarLabels.HolidayIcon">
        <div class="d-flex align-center mb-4">
            <MudText Typo="Typo.body2" Class="mud-text-secondary flex-grow-1">Days the whole organization has off. A half day counts as half a working day in each sprint.</MudText>
            <MudSwitch @bind-Value="showPast" Color="Color.Primary" Label="Show past" Class="mr-4" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => EditAsync(null))">Add holiday</MudButton>
        </div>

        <MudTable Items="ShownHolidays" Hover="true" Dense="true" Loading="isLoading" Elevation="0">
            <HeaderContent>
                <MudTh>Date</MudTh>
                <MudTh>Name</MudTh>
                <MudTh>Length</MudTh>
                <MudTh Style="width: 7rem;"></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Date">@context.Date.ToString(UiFormats.ShortDateWithWeekday)</MudTd>
                <MudTd DataLabel="Name">@context.Name</MudTd>
                <MudTd DataLabel="Length">@CalendarLabels.Duration(context.Duration)</MudTd>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => EditAsync(context))" aria-label="@($"Edit {context.Name}")" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteAsync(context))" aria-label="@($"Delete {context.Name}")" />
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>@(holidays.Count == 0 ? "No holidays recorded yet." : "No holidays from today on. Turn on Show past to list earlier ones.")</NoRecordsContent>
        </MudTable>
    </MudTabPanel>
</MudTabs>

@code {
    private IReadOnlyList<HolidayDto> holidays = [];
    private bool isLoading = true;
    private bool showPast;
    private DateOnly today;

    private IEnumerable<HolidayDto> ShownHolidays => showPast ? holidays : holidays.Where(holiday => holiday.Date >= today);

    protected override Task OnInitializedAsync()
    {
        today = Clock.Today(UiOptions.Value.ResolveTimeZone());
        return ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        isLoading = true;
        holidays = await HolidayService.GetAllAsync();
        isLoading = false;
    }

    private async Task EditAsync(HolidayDto? holiday)
    {
        DialogParameters<HolidayDialog> parameters = new() { { dialog => dialog.Holiday, holiday?.ToEditDto() ?? new HolidayEditDto() } };
        IDialogReference reference = await DialogService.ShowAsync<HolidayDialog>(null, parameters);

        if (!(await reference.Result)!.Canceled)
        {
            await ReloadAsync();
        }
    }

    private async Task DeleteAsync(HolidayDto holiday)
    {
        bool? confirmed = await DialogService.ShowMessageBoxAsync("Remove holiday", $"Remove {holiday.Name} on {holiday.Date.ToString(UiFormats.ShortDate)}?", yesText: "Remove", cancelText: "Cancel");
        if (confirmed == true)
        {
            await HolidayService.DeleteAsync(holiday.Id);
            await ReloadAsync();
        }
    }
}
