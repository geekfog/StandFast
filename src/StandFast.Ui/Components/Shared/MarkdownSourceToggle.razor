@* Switches markdown between its source and its rendered preview. Shared by a single editor's toolbar and by the update panel, which switches all its boxes at once. *@
<MudTooltip Text="@Description">
    <MudButton Variant="Variant.Filled" Color="Color.Default" DropShadow="false" Size="@Size" StartIcon="@(Preview ? Icons.Material.Filled.Edit : Icons.Material.Filled.Visibility)" OnClick="@(() => PreviewChanged.InvokeAsync(!Preview))" aria-label="@Description">
        @Label
    </MudButton>
</MudTooltip>

@code {
    [Parameter]
    public bool Preview { get; set; }

    [Parameter]
    public EventCallback<bool> PreviewChanged { get; set; }

    /// <summary>What the toggle switches, appended to its tooltip, for a toggle that switches more than one box.</summary>
    [Parameter]
    public string? Target { get; set; }

    [Parameter]
    public Size Size { get; set; } = Size.Small;

    private string Label => Preview ? "Edit" : "Preview";

    private string Description => Target is null ? Label : $"{Label} {Target}";
}
