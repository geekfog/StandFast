@using StandFast.Domain.Abstractions
@inject IClock Clock

<MudPaper Outlined="true"
          Class="@($"d-flex align-center pa-2 mb-2 {(CanAdvance ? "standfast-participant" : "standfast-participant-inert")} {(IsSelected ? "standfast-participant-selected" : string.Empty)}")"
          @onclick="OnAdvanceAsync">
    @if (ShowPriorTurn)
    {
        <MudTooltip Text="@PriorTurnDescription">
            <div class="standfast-prior-turn mr-2" aria-label="@PriorTurnDescription">@PriorTurnLabel</div>
        </MudTooltip>
    }

    <PersonAvatar Initials="@Participant.Initials" PhotoUrl="@PersonPhotoUrls.Saved(Participant.PersonId, Participant.PhotoSavedUtc)" Color="@StandFastTheme.ColumnColor(Participant.State)" IsRinged="true" />

    <div class="ml-3 flex-grow-1 standfast-participant-text">
        <div class="d-flex align-center">
            <MudText Typo="Typo.body1">@Participant.DisplayName</MudText>
            @if (IsSelf)
            {
                <MudTooltip Text="@SelfDescription">
                    <MudIcon Icon="@Icons.Material.Filled.Star" Size="Size.Small" Class="standfast-self-marker ml-1" aria-label="@SelfDescription" />
                </MudTooltip>
            }
            @if (Availability is { } availability)
            {
                string description = CalendarLabels.AvailabilityDescription(availability, Sprint);
                <MudTooltip Text="@description">
                    <MudIcon Icon="@CalendarLabels.DaysOffIcon" Size="Size.Small" Color="Color.Warning" Class="ml-1" aria-label="@description" />
                </MudTooltip>
            }
        </div>
        @* Each fact sits in its own tinted pill, which separates them without dividers and lets them wrap as whole units on a narrow card. *@
        <MudText Typo="Typo.caption" Class="mud-text-secondary standfast-card-facts">
            <MudTooltip>
                <TooltipContent>
                    @if (!string.IsNullOrWhiteSpace(Participant.Title))
                    {
                        <div>@PersonLabels.Title: @Participant.Title</div>
                    }
                    <div>@PersonLabels.Email: @Participant.Email</div>
                </TooltipContent>
                <ChildContent>
                    <span class="standfast-card-fact">@StatusCaption</span>
                </ChildContent>
            </MudTooltip>
            @if (OffsetFromStandup is { } offset)
            {
                @* The tooltip shows the person's time now, so it reads the clock each time it opens rather than when the card last rendered. *@
                <MudTooltip VisibleChanged="OnOffsetTooltipVisibleChanged">
                    <TooltipContent>@OffsetTooltip(offset)</TooltipContent>
                    <ChildContent>
                        <span class="standfast-card-fact">@offset.ToOffsetLabel()</span>
                    </ChildContent>
                </MudTooltip>
            }
            @if (TenureAtMeeting is { } tenure)
            {
                <MudTooltip Text="@($"{PersonLabels.StartDate}: {Participant.StartDate!.Value.ToString(UiFormats.LongDate)}")">
                    <span class="standfast-card-fact">@tenure.ToTenureLabel()</span>
                </MudTooltip>
            }
        </MudText>
    </div>

    @if (Participant.Blockers is not null)
    {
        <MudTooltip Text="Has blockers">
            <MudIcon Icon="@Icons.Material.Filled.ReportProblem" Color="Color.Warning" Size="Size.Small" />
        </MudTooltip>
    }

    @* The card body is the tap target that advances a participant, so the per-button actions stop the click from bubbling back up to it. *@
    <div class="d-flex align-center" @onclick:stopPropagation="true">
        @* Colour marks who already has an update recorded, in every column; the card's outline is what marks the one currently open. *@
        <MudTooltip Text="@UpdateActionDescription">
            <MudIconButton Icon="@Icons.Material.Filled.EditNote"
                           Size="Size.Small"
                           Color="@(Participant.HasUpdate ? Color.Tertiary : Color.Default)"
                           OnClick="OnSelectAsync"
                           aria-label="@($"{UpdateActionDescription} for {Participant.DisplayName}")" />
        </MudTooltip>

        @if (Participant.State != AttendanceState.Roster && !IsLocked)
        {
            <MudTooltip Text="Move back">
                <MudIconButton Icon="@Icons.Material.Filled.Undo"
                               Size="Size.Small"
                               OnClick="OnRevertAsync"
                               aria-label="@($"Move {Participant.DisplayName} back")" />
            </MudTooltip>
        }
    </div>
</MudPaper>

@code {
    [Parameter]
    [EditorRequired]
    public BoardParticipantDto Participant { get; set; } = default!;

    [Parameter]
    public TimeZoneInfo TimeZone { get; set; } = TimeZoneInfo.Local;

    /// <summary>When the standup starts on the date shown. The participant's offset from <see cref="TimeZone"/> is measured at this instant.</summary>
    [Parameter]
    public DateTimeOffset MeetingStart { get; set; }

    /// <summary>The date shown on the board. The participant's time at the organization is measured up to this date.</summary>
    [Parameter]
    public DateOnly MeetingDate { get; set; }

    [Parameter]
    public bool IsSelected { get; set; }

    /// <summary>Marks the card belonging to whoever is signed in, so someone scanning a long roster finds themselves without reading the names.</summary>
    [Parameter]
    public bool IsSelf { get; set; }

    /// <summary>Set once the date has been closed. The card still opens the update for reading, and every action that would change something is withheld.</summary>
    [Parameter]
    public bool IsLocked { get; set; }

    /// <summary>The turn this person took at the previous standup, or null when they were not there.</summary>
    [Parameter]
    public int? PriorTurn { get; set; }

    /// <summary>How the person's days off bear on this date and the rest of its sprint, or null when they have none that do. Marks the card when set.</summary>
    [Parameter]
    public PersonAvailabilityDto? Availability { get; set; }

    /// <summary>The sprint covering this date, which the days off marker measures against.</summary>
    [Parameter]
    public SprintStatusDto? Sprint { get; set; }

    /// <summary>Shown only where the turn is actionable, which is the column you are choosing the next speaker from.</summary>
    [Parameter]
    public bool ShowPriorTurn { get; set; }

    [Parameter]
    public EventCallback<Guid> OnAdvance { get; set; }

    [Parameter]
    public EventCallback<Guid> OnRevert { get; set; }

    [Parameter]
    public EventCallback<Guid> OnSelect { get; set; }

    private const string SelfDescription = "This is you";

    private string UpdateActionDescription => Participant.HasUpdate ? "Open recorded update" : "Open update";

    private string PriorTurnLabel => PriorTurn?.ToString() ?? UiFormats.NoPriorTurnSymbol;

    private string PriorTurnDescription => PriorTurn is { } turn
        ? $"Went {turn.ToOrdinal()} at the previous standup"
        : "Did not present at the previous standup";

    private string StatusCaption => Participant.State switch
    {
        AttendanceState.Presented => $"Presented {Participant.PresentedUtc.ToLocalDisplay(TimeZone, UiFormats.DateAndTimeWithSeconds)}",
        AttendanceState.Available => $"Available since {Participant.MarkedAvailableUtc.ToLocalDisplay(TimeZone)}",
        AttendanceState.Leader => $"Leader since {Participant.MarkedAvailableUtc.ToLocalDisplay(TimeZone)}",
        AttendanceState.Guest => $"Guest since {Participant.MarkedAvailableUtc.ToLocalDisplay(TimeZone)}",
        _ => Participant.UpdateSavedUtc is null ? "Not yet marked present" : $"Update saved {Participant.UpdateSavedUtc.ToLocalDisplay(TimeZone)}",
    };

    /// <summary>When the offset tooltip last opened, so it shows the participant's time as of then.</summary>
    private DateTimeOffset offsetTooltipOpenedUtc;

    private TimeZoneInfo? ParticipantTimeZone => TimeZoneIds.Resolve(Participant.TimeZoneId);

    /// <summary>How far the participant's clock is from the standup's, or null when their time zone is not recorded.</summary>
    private TimeSpan? OffsetFromStandup => ParticipantTimeZone is { } zone ? TimeZoneIds.OffsetFrom(zone, TimeZone, MeetingStart) : null;

    /// <summary>Time at the organization as of the meeting date, or null when no start date is recorded or it falls after that date.</summary>
    private Tenure? TenureAtMeeting => Participant.StartDate is { } start ? Tenure.Between(start, MeetingDate) : null;

    private string OffsetTooltip(TimeSpan offset)
    {
        string description = $"{offset.ToOffsetDescription()} · {TimeZoneInfo.ConvertTime(offsetTooltipOpenedUtc, ParticipantTimeZone!).ToString(UiFormats.TimeOfDay)} there now";
        return string.IsNullOrEmpty(Participant.Location) ? description : $"{Participant.Location} · {description}";
    }

    private void OnOffsetTooltipVisibleChanged(bool visible)
    {
        if (visible)
        {
            offsetTooltipOpenedUtc = Clock.UtcNow;
        }
    }

    /// <summary>False on a locked date, and for anyone a tap would leave where they are, such as a guest already recorded.</summary>
    private bool CanAdvance => !IsLocked && AttendanceTransitions.Advance(Participant.State, Participant.Kind, Participant.Presents) != Participant.State;

    private Task OnAdvanceAsync() => CanAdvance ? OnAdvance.InvokeAsync(Participant.PersonId) : Task.CompletedTask;

    private Task OnRevertAsync() => OnRevert.InvokeAsync(Participant.PersonId);

    private Task OnSelectAsync() => OnSelect.InvokeAsync(Participant.PersonId);
}
