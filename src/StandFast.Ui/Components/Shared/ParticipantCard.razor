<MudPaper Outlined="true"
          Class="@($"d-flex align-center pa-2 mb-2 standfast-participant {(IsSelected ? "standfast-participant-selected" : string.Empty)}")"
          @onclick="OnAdvanceAsync">
    @if (ShowPriorTurn)
    {
        <MudTooltip Text="@PriorTurnDescription">
            <div class="standfast-prior-turn mr-2" aria-label="@PriorTurnDescription">@PriorTurnLabel</div>
        </MudTooltip>
    }

    <MudAvatar Color="@StandFastTheme.ColumnColor(Participant.State)" Size="Size.Medium">@Participant.Initials</MudAvatar>

    <div class="ml-3 flex-grow-1 standfast-participant-text">
        <div class="d-flex align-center">
            <MudText Typo="Typo.body1">@Participant.DisplayName</MudText>
            @if (IsSelf)
            {
                <MudTooltip Text="@SelfDescription">
                    <MudIcon Icon="@Icons.Material.Filled.Star" Size="Size.Small" Class="standfast-self-marker ml-1" aria-label="@SelfDescription" />
                </MudTooltip>
            }
        </div>
        <MudText Typo="Typo.caption" Class="mud-text-secondary">@StatusCaption</MudText>
    </div>

    @if (Participant.Blockers is not null)
    {
        <MudTooltip Text="Has blockers">
            <MudIcon Icon="@Icons.Material.Filled.ReportProblem" Color="Color.Warning" Size="Size.Small" />
        </MudTooltip>
    }

    @* The card body is the tap target that advances a participant, so the per-button actions stop the click from bubbling back up to it. *@
    <div class="d-flex align-center" @onclick:stopPropagation="true">
        @* Colour marks who already has an update recorded, in every column; the card's outline is what marks the one currently open. *@
        <MudTooltip Text="@UpdateActionDescription">
            <MudIconButton Icon="@Icons.Material.Filled.EditNote"
                           Size="Size.Small"
                           Color="@(Participant.HasUpdate ? Color.Tertiary : Color.Default)"
                           OnClick="OnSelectAsync"
                           aria-label="@($"{UpdateActionDescription} for {Participant.DisplayName}")" />
        </MudTooltip>

        @if (Participant.State != AttendanceState.Roster)
        {
            <MudTooltip Text="Move back">
                <MudIconButton Icon="@Icons.Material.Filled.Undo"
                               Size="Size.Small"
                               OnClick="OnRevertAsync"
                               aria-label="@($"Move {Participant.DisplayName} back")" />
            </MudTooltip>
        }
    </div>
</MudPaper>

@code {
    [Parameter]
    [EditorRequired]
    public BoardParticipantDto Participant { get; set; } = default!;

    [Parameter]
    public TimeZoneInfo TimeZone { get; set; } = TimeZoneInfo.Local;

    [Parameter]
    public bool IsSelected { get; set; }

    /// <summary>Marks the card belonging to whoever is signed in, so someone scanning a long roster finds themselves without reading the names.</summary>
    [Parameter]
    public bool IsSelf { get; set; }

    /// <summary>The turn this person took at the previous standup, or null when they were not there.</summary>
    [Parameter]
    public int? PriorTurn { get; set; }

    /// <summary>Shown only where the turn is actionable, which is the column you are choosing the next speaker from.</summary>
    [Parameter]
    public bool ShowPriorTurn { get; set; }

    [Parameter]
    public EventCallback<Guid> OnAdvance { get; set; }

    [Parameter]
    public EventCallback<Guid> OnRevert { get; set; }

    [Parameter]
    public EventCallback<Guid> OnSelect { get; set; }

    private const string SelfDescription = "This is you";

    private string UpdateActionDescription => Participant.HasUpdate ? "Open recorded update" : "Open update";

    private string PriorTurnLabel => PriorTurn?.ToString() ?? UiFormats.NoPriorTurnSymbol;

    private string PriorTurnDescription => PriorTurn is { } turn
        ? $"Went {turn.ToOrdinal()} at the previous standup"
        : "Did not present at the previous standup";

    private string StatusCaption => Participant.State switch
    {
        AttendanceState.Presented => $"Presented {Participant.PresentedUtc.ToLocalDisplay(TimeZone, UiFormats.DateAndTimeWithSeconds)}",
        AttendanceState.Available => $"Available since {Participant.MarkedAvailableUtc.ToLocalDisplay(TimeZone)}",
        _ => Participant.UpdateSavedUtc is null ? "Not yet marked present" : $"Update saved {Participant.UpdateSavedUtc.ToLocalDisplay(TimeZone)}",
    };

    private Task OnAdvanceAsync() => OnAdvance.InvokeAsync(Participant.PersonId);

    private Task OnRevertAsync() => OnRevert.InvokeAsync(Participant.PersonId);

    private Task OnSelectAsync() => OnSelect.InvokeAsync(Participant.PersonId);
}
