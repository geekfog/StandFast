@inject IJSRuntime JS
@implements IAsyncDisposable

<MudPaper Outlined="true" Class="standfast-markdown-editor">
    <MudToolBar Dense="true" Gutters="false" Class="px-2 standfast-markdown-toolbar">
        <MudText Typo="Typo.subtitle2" Class="mr-2">@Label</MudText>
        @if (!ReadOnly)
        {
            @foreach (MarkdownCommand command in MarkdownCommands.All)
            {
                <MudTooltip Text="@command.Tooltip">
                    <MudIconButton Icon="@command.Icon" Size="Size.Small" OnClick="@(() => ApplyAsync(command))" aria-label="@command.Tooltip" />
                </MudTooltip>
            }
        }
        <MudSpacer />
        @if (!ReadOnly && ShowSourceToggle)
        {
            <MarkdownSourceToggle ShowSource="IsShowingSource" ShowSourceChanged="SetShowSourceAsync" />
        }
        @if (!HasToolbarButtons)
        {
            <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" Disabled="true" Class="standfast-toolbar-height-keeper" tabindex="-1" aria-hidden="true" />
        }
        @if (ExpandedChanged.HasDelegate)
        {
            <MudTooltip Text="@ExpandTooltip">
                <MudIconButton Icon="@(Expanded ? Icons.Material.Filled.Close : Icons.Material.Filled.OpenInFull)" Size="Size.Small" OnClick="ToggleExpandedAsync" aria-label="@ExpandTooltip" />
            </MudTooltip>
        }
    </MudToolBar>

    <div id="@editorId" class="pa-3 standfast-markdown-body" style="@($"{LinesCssProperty}: {Lines}")">
        @if (ReadOnly)
        {
            <MarkdownView Value="@Value" EmptyText="@EmptyText" />
        }
        else if (IsShowingSource)
        {
            <MudTextField T="string"
                          Value="@Value"
                          ValueChanged="OnTextChangedAsync"
                          Lines="@Lines"
                          MaxLength="DomainLimits.MarkdownMaxLength"
                          Immediate="true"
                          Variant="Variant.Text"
                          Underline="false"
                          Placeholder="@Placeholder"
                          aria-label="@Label" />
        }
        else
        {
            @* The formatted editor owns everything inside this element, so Blazor renders it empty and never diffs into it. *@
            <div id="@visualEditorId" class="standfast-markdown-visual" aria-label="@Label"></div>
        }
    </div>
</MudPaper>

@code {
    /// <summary>Carries <see cref="Lines"/> to app.css, which keeps a text box that sizes to its content at least that many lines tall.</summary>
    private const string LinesCssProperty = "--standfast-markdown-lines";

    private const string PrefixLinesFunction = "standFastMarkdown.prefixLines";
    private const string WrapSelectionFunction = "standFastMarkdown.wrapSelection";
    private const string ShiftLinesFunction = "standFastMarkdown.shiftLines";
    private const string AttachFunction = "standFastMarkdown.attach";
    private const string DetachFunction = "standFastMarkdown.detach";

    /// <summary>The formatted editor, loaded on first use since it is far larger than the rest of the page's script.</summary>
    private const string VisualModulePath = "./js/markdown-visual.js";
    private const string VisualCreateFunction = "create";
    private const string VisualSetMarkdownFunction = "setMarkdown";
    private const string VisualApplyFunction = "apply";
    private const string VisualDestroyFunction = "destroy";

    private readonly string editorId = $"markdown-{Guid.NewGuid():N}";
    private readonly string visualEditorId = $"markdown-visual-{Guid.NewGuid():N}";
    private DotNetObjectReference<MarkdownEditor>? selfReference;
    private IJSObjectReference? visualModule;
    private bool showSource;
    private bool isVisualEditorOpen;

    // The text the formatted editor holds, so only text changed outside it is pushed back in.
    private string? visualEditorValue;

    [Parameter]
    public string Label { get; set; } = string.Empty;

    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }

    [Parameter]
    public bool ReadOnly { get; set; }

    public const int DefaultLines = 6;

    [Parameter]
    public int Lines { get; set; } = DefaultLines;

    [Parameter]
    public string Placeholder { get; set; } = "Markdown supported.";

    [Parameter]
    public string EmptyText { get; set; } = "Nothing recorded.";

    /// <summary>Whether the editor fills its container. The expand button, which becomes a close button while expanded, appears only when <see cref="ExpandedChanged"/> is bound.</summary>
    [Parameter]
    public bool Expanded { get; set; }

    [Parameter]
    public EventCallback<bool> ExpandedChanged { get; set; }

    /// <summary>Whether the box shows the markdown source instead of formatted text. Owned by the parent when <see cref="ShowSourceChanged"/> is bound, so several boxes can switch together.</summary>
    [Parameter]
    public bool ShowSource { get; set; }

    [Parameter]
    public EventCallback<bool> ShowSourceChanged { get; set; }

    /// <summary>False when the parent offers its own source toggle for this box.</summary>
    [Parameter]
    public bool ShowSourceToggle { get; set; } = true;

    private bool IsShowingSource => ShowSourceChanged.HasDelegate ? ShowSource : showSource;

    private bool IsVisualEditorShown => !ReadOnly && !IsShowingSource;

    private bool HasToolbarButtons => !ReadOnly || ExpandedChanged.HasDelegate;

    private string ExpandTooltip => Expanded ? "Close expanded view" : "Expand";

    private Task ToggleExpandedAsync() => ExpandedChanged.InvokeAsync(!Expanded);

    private Task OnTextChangedAsync(string? value) => ValueChanged.InvokeAsync(value);

    private Task SetShowSourceAsync(bool value)
    {
        if (ShowSourceChanged.HasDelegate)
        {
            return ShowSourceChanged.InvokeAsync(value);
        }

        showSource = value;
        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            selfReference = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync(AttachFunction, editorId, selfReference, nameof(OnListEditedAsync));
        }

        await SyncVisualEditorAsync();
    }

    /// <summary>Opens or closes the formatted editor to match what the box shows, and hands it text that changed outside it, such as copied prior text or a cancel.</summary>
    private async Task SyncVisualEditorAsync()
    {
        if (IsVisualEditorShown && !isVisualEditorOpen)
        {
            visualModule ??= await JS.InvokeAsync<IJSObjectReference>("import", VisualModulePath);
            isVisualEditorOpen = true;
            visualEditorValue = Value;
            var options = new { PlaceholderText = Placeholder, MaxLength = DomainLimits.MarkdownMaxLength, MarkdownCommands.ItalicMarker };
            await visualModule.InvokeVoidAsync(VisualCreateFunction, visualEditorId, Value, options, selfReference, nameof(OnVisualEditedAsync));
        }
        else if (!IsVisualEditorShown && isVisualEditorOpen)
        {
            isVisualEditorOpen = false;
            await visualModule!.InvokeVoidAsync(VisualDestroyFunction, visualEditorId);
        }
        else if (isVisualEditorOpen && Value != visualEditorValue)
        {
            visualEditorValue = Value;
            await visualModule!.InvokeVoidAsync(VisualSetMarkdownFunction, visualEditorId, Value);
        }
    }

    /// <summary>Called by the browser after it edited a list: Enter continued or ended one, or a deletion renumbered one. Carries the text it produced.</summary>
    [JSInvokable]
    public Task OnListEditedAsync(string value) => ValueChanged.InvokeAsync(value);

    /// <summary>Called by the formatted editor after every edit, with the markdown it now holds.</summary>
    [JSInvokable]
    public Task OnVisualEditedAsync(string value)
    {
        visualEditorValue = value;
        return ValueChanged.InvokeAsync(value);
    }

    private async Task ApplyAsync(MarkdownCommand command)
    {
        if (isVisualEditorOpen)
        {
            await visualModule!.InvokeVoidAsync(VisualApplyFunction, visualEditorId, command.VisualAction.ToString(), command.LinePrefix, command.Placeholder);
            return;
        }

        string? updated = command switch
        {
            { IsListShiftCommand: true } => await JS.InvokeAsync<string?>(ShiftLinesFunction, editorId, command.ListShift),
            { IsBlockCommand: true } => await JS.InvokeAsync<string?>(PrefixLinesFunction, editorId, command.LinePrefix ?? string.Empty, command.Ordered),
            _ => await JS.InvokeAsync<string?>(WrapSelectionFunction, editorId, command.Before, command.After, command.Placeholder),
        };

        if (updated is not null)
        {
            await ValueChanged.InvokeAsync(updated);
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync(DetachFunction, editorId);
            if (visualModule is not null)
            {
                if (isVisualEditorOpen)
                {
                    await visualModule.InvokeVoidAsync(VisualDestroyFunction, visualEditorId);
                }

                await visualModule.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // The circuit closed before the component did, which takes the listener and the editor with it.
        }

        selfReference?.Dispose();
    }
}
