@inject IJSRuntime JS
@inject IMarkdownRenderer Markdown
@implements IAsyncDisposable

<MudPaper Outlined="true" Class="standfast-markdown-editor">
    <MudToolBar Dense="true" Gutters="false" Class="px-2 standfast-markdown-toolbar">
        <MudText Typo="Typo.subtitle2" Class="mr-2">@Label</MudText>
        @if (!ReadOnly)
        {
            @foreach (MarkdownCommand command in MarkdownCommands.All)
            {
                <MudTooltip Text="@command.Tooltip">
                    <MudIconButton Icon="@command.Icon" Size="Size.Small" Disabled="IsPreviewing"OnClick="@(() => ApplyAsync(command))" aria-label="@command.Tooltip" />
                </MudTooltip>
            }
        }
        <MudSpacer />
        @if (!ReadOnly && ShowPreviewToggle)
        {
            <MarkdownPreviewToggle Preview="IsPreviewing" PreviewChanged="SetPreviewAsync" />
        }
        @if (!HasToolbarButtons)
        {
            <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" Disabled="true" Class="standfast-toolbar-height-keeper" tabindex="-1" aria-hidden="true" />
        }
        @if (ExpandedChanged.HasDelegate)
        {
            <MudTooltip Text="@ExpandTooltip">
                <MudIconButton Icon="@(Expanded ? Icons.Material.Filled.Close : Icons.Material.Filled.OpenInFull)" Size="Size.Small" OnClick="ToggleExpandedAsync" aria-label="@ExpandTooltip" />
            </MudTooltip>
        }
    </MudToolBar>

    <div id="@editorId" class="pa-3 standfast-markdown-body" style="@($"{LinesCssProperty}: {Lines}")">
        @if (IsPreviewing || ReadOnly)
        {
            <MarkdownView Value="@Value" EmptyText="@EmptyText" InteractiveTasks="@(!ReadOnly)" />
        }
        else
        {
            <MudTextField T="string"
                          Value="@Value"
                          ValueChanged="OnTextChangedAsync"
                          Lines="@Lines"
                          MaxLength="DomainLimits.MarkdownMaxLength"
                          Immediate="true"
                          Variant="Variant.Text"
                          Underline="false"
                          Placeholder="@Placeholder"
                          aria-label="@Label" />
        }
    </div>
</MudPaper>

@code {
    /// <summary>Carries <see cref="Lines"/> to app.css, which keeps a text box that sizes to its content at least that many lines tall.</summary>
    private const string LinesCssProperty = "--standfast-markdown-lines";

    private const string PrefixLinesFunction = "standFastMarkdown.prefixLines";
    private const string WrapSelectionFunction = "standFastMarkdown.wrapSelection";
    private const string ShiftLinesFunction = "standFastMarkdown.shiftLines";
    private const string AttachFunction = "standFastMarkdown.attach";
    private const string DetachFunction = "standFastMarkdown.detach";

    private readonly string editorId = $"markdown-{Guid.NewGuid():N}";
    private DotNetObjectReference<MarkdownEditor>? selfReference;
    private bool showPreview;

    [Parameter]
    public string Label { get; set; } = string.Empty;

    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }

    [Parameter]
    public bool ReadOnly { get; set; }

    public const int DefaultLines = 6;

    [Parameter]
    public int Lines { get; set; } = DefaultLines;

    [Parameter]
    public string Placeholder { get; set; } = "Markdown supported.";

    [Parameter]
    public string EmptyText { get; set; } = "Nothing recorded.";

    /// <summary>Whether the editor fills its container. The expand button, which becomes a close button while expanded, appears only when <see cref="ExpandedChanged"/> is bound.</summary>
    [Parameter]
    public bool Expanded { get; set; }

    [Parameter]
    public EventCallback<bool> ExpandedChanged { get; set; }

    /// <summary>Whether the box shows rendered text. Owned by the parent when <see cref="PreviewChanged"/> is bound, so several boxes can switch together.</summary>
    [Parameter]
    public bool Preview { get; set; }

    [Parameter]
    public EventCallback<bool> PreviewChanged { get; set; }

    /// <summary>False when the parent offers its own preview toggle for this box.</summary>
    [Parameter]
    public bool ShowPreviewToggle { get; set; } = true;

    private bool IsPreviewing => PreviewChanged.HasDelegate ? Preview : showPreview;

    private bool HasToolbarButtons => !ReadOnly || ExpandedChanged.HasDelegate;

    private string ExpandTooltip => Expanded ? "Close expanded view" : "Expand";

    private Task ToggleExpandedAsync() => ExpandedChanged.InvokeAsync(!Expanded);

    private Task OnTextChangedAsync(string? value) => ValueChanged.InvokeAsync(value);

    private Task SetPreviewAsync(bool preview)
    {
        if (PreviewChanged.HasDelegate)
        {
            return PreviewChanged.InvokeAsync(preview);
        }

        showPreview = preview;
        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        selfReference = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync(AttachFunction, editorId, selfReference, nameof(OnListEditedAsync), nameof(OnTaskToggledAsync));
    }

    /// <summary>Called by the browser after it edited a list: Enter continued or ended one, or a deletion renumbered one. Carries the text it produced.</summary>
    [JSInvokable]
    public Task OnListEditedAsync(string value) => ValueChanged.InvokeAsync(value);

    /// <summary>Called by the browser when a preview checkbox is clicked, with its position among the preview's checkboxes.</summary>
    [JSInvokable]
    public Task OnTaskToggledAsync(int taskIndex) =>
        ReadOnly || Markdown.ToggleTask(Value, taskIndex) is not { } updated ? Task.CompletedTask : ValueChanged.InvokeAsync(updated);

    private async Task ApplyAsync(MarkdownCommand command)
    {
        string? updated = command switch
        {
            { IsListShiftCommand: true } => await JS.InvokeAsync<string?>(ShiftLinesFunction, editorId, command.ListShift),
            { IsBlockCommand: true } => await JS.InvokeAsync<string?>(PrefixLinesFunction, editorId, command.LinePrefix ?? string.Empty, command.Ordered),
            _ => await JS.InvokeAsync<string?>(WrapSelectionFunction, editorId, command.Before, command.After, command.Placeholder),
        };

        if (updated is not null)
        {
            await ValueChanged.InvokeAsync(updated);
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync(DetachFunction, editorId);
        }
        catch (JSDisconnectedException)
        {
            // The circuit closed before the component did, which takes the listener with it.
        }

        selfReference?.Dispose();
    }
}
