<MudPaper Outlined="true" Class="pa-4">
    <div class="d-flex align-center mb-3">
        <MudAvatar Color="@StandFastTheme.ColumnColor(Participant.State)" Class="mr-3">@Participant.Initials</MudAvatar>
        <div>
            <MudText Typo="Typo.h6">@Participant.DisplayName</MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">@Participant.Email</MudText>
        </div>
        @if (string.IsNullOrWhiteSpace(Participant.Notes))
        {
            <MudSpacer />
        }
        else
        {
            <div class="flex-grow-1 mx-4 standfast-person-notes">
                <MarkdownView Value="@Participant.Notes" />
            </div>
        }
        <MudButton Variant="Variant.Text" Color="Color.Default" StartIcon="@Icons.Material.Filled.Close" OnClick="CancelAsync" Class="mr-2">
            @(IsReadOnly ? "Close" : "Cancel")
        </MudButton>
        @if (!IsReadOnly)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" Disabled="@(!IsDirty || isSaving)" OnClick="SaveAsync">
                @(isSaving ? "Saving..." : "Save update")
            </MudButton>
        }
    </div>

    <MudGrid Spacing="3">
        <MudItem xs="12" md="3" Class="standfast-markdown-column">
            <MarkdownEditor Label="@PriorLabel"
                            Value="@Participant.PriorUpdate"
                            ReadOnly="true"
                            EmptyText="No earlier update recorded for this standup." />
            @if (!string.IsNullOrWhiteSpace(Participant.PriorBlockers))
            {
                <MudExpansionPanels Elevation="0" Class="mt-2">
                    <MudExpansionPanel Text="Prior blockers" Dense="true">
                        <MarkdownView Value="@Participant.PriorBlockers" />
                    </MudExpansionPanel>
                </MudExpansionPanels>
            }
            @if (!string.IsNullOrWhiteSpace(Participant.PriorParkingLot))
            {
                <MudExpansionPanels Elevation="0" Class="mt-2">
                    <MudExpansionPanel Text="Prior parking lot" Dense="true">
                        <MarkdownView Value="@Participant.PriorParkingLot" />
                    </MudExpansionPanel>
                </MudExpansionPanels>
            }
        </MudItem>

        <MudItem xs="12" md="3" Class="standfast-markdown-column">
            <MarkdownEditor Label="Current update" @bind-Value="currentUpdate" ReadOnly="@IsReadOnly" Placeholder="What did you do, what is next?" EmptyText="Nothing recorded for this date.">
                <ToolbarActions>
                    @if (!IsReadOnly)
                    {
                        <MudTooltip Text="Copy the prior update into this box">
                            <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                                           Size="Size.Small"
                                           Disabled="@(!Participant.HasPrior)"
                                           OnClick="CopyPriorForward"
                                           aria-label="Copy prior update forward" />
                        </MudTooltip>
                    }
                </ToolbarActions>
            </MarkdownEditor>
        </MudItem>

        <MudItem xs="12" md="3" Class="standfast-markdown-column">
            <MarkdownEditor Label="Blockers" @bind-Value="blockers" ReadOnly="@IsReadOnly" Placeholder="Anything in the way?" EmptyText="No blockers recorded." />
        </MudItem>

        <MudItem xs="12" md="3" Class="standfast-markdown-column">
            <MarkdownEditor Label="Parking lot" @bind-Value="parkingLot" ReadOnly="@IsReadOnly" Placeholder="Anything to take offline after the standup?" EmptyText="Nothing parked." />
        </MudItem>
    </MudGrid>

    <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2">
        @(Participant.UpdateSavedUtc is null ? "Not saved yet." : $"Last saved {Participant.UpdateSavedUtc.ToLocalDisplay(TimeZone)}.")
    </MudText>
</MudPaper>

@code {
    private string? currentUpdate;
    private string? blockers;
    private string? parkingLot;
    private Guid loadedPersonId;
    private DateOnly loadedDate;
    private bool isSaving;

    [Parameter]
    [EditorRequired]
    public BoardParticipantDto Participant { get; set; } = default!;

    [Parameter]
    public Guid StandupId { get; set; }

    [Parameter]
    public DateOnly MeetingDate { get; set; }

    [Parameter]
    public TimeZoneInfo TimeZone { get; set; } = TimeZoneInfo.Local;

    /// <summary>Set once the date has been closed, which leaves the panel as a way of reading what was recorded.</summary>
    [Parameter]
    public bool IsReadOnly { get; set; }

    [Parameter]
    public EventCallback<ParticipantUpdateDto> OnSave { get; set; }

    /// <summary>Raised once the panel should close, after any unsaved edits have been confirmed as expendable.</summary>
    [Parameter]
    public EventCallback OnClose { get; set; }

    [Inject]
    private IDialogService DialogService { get; set; } = default!;

    private bool IsDirty => currentUpdate != Participant.Update || blockers != Participant.Blockers || parkingLot != Participant.ParkingLot;

    private string PriorLabel => Participant.PriorMeetingDate is { } date
        ? $"Prior update ({date.ToDateTime(TimeOnly.MinValue).ToString(UiFormats.ShortDate)})"
        : "Prior update";

    // Editing state is local so typing does not round-trip to storage, and is re-seeded whenever the panel switches person or date.
    protected override void OnParametersSet()
    {
        if (loadedPersonId == Participant.PersonId && loadedDate == MeetingDate)
        {
            return;
        }

        loadedPersonId = Participant.PersonId;
        loadedDate = MeetingDate;
        currentUpdate = Participant.Update;
        blockers = Participant.Blockers;
        parkingLot = Participant.ParkingLot;
    }

    private void CopyPriorForward() => currentUpdate = Participant.PriorUpdate;

    /// <summary>Closes the panel, asking first when there are edits that have not been saved. Unsaved text is discarded, so the boxes re-seed from storage when the panel is next opened.</summary>
    private async Task CancelAsync()
    {
        if (IsDirty)
        {
            bool? confirmed = await DialogService.ShowMessageBoxAsync(
                "Discard changes",
                $"Close the update for {Participant.DisplayName} without saving? The changes typed here are lost.",
                yesText: "Discard",
                cancelText: "Keep editing");

            if (confirmed != true)
            {
                return;
            }
        }

        currentUpdate = Participant.Update;
        blockers = Participant.Blockers;
        parkingLot = Participant.ParkingLot;
        await OnClose.InvokeAsync();
    }

    private async Task SaveAsync()
    {
        isSaving = true;

        try
        {
            await OnSave.InvokeAsync(new ParticipantUpdateDto
            {
                StandupId = StandupId,
                PersonId = Participant.PersonId,
                MeetingDate = MeetingDate,
                Update = currentUpdate,
                Blockers = blockers,
                ParkingLot = parkingLot,
            });
        }
        finally
        {
            isSaving = false;
        }
    }
}
