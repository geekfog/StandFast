<MudPaper Outlined="true" Class="pa-4">
    @if (expandedField is null)
    {
        <div class="d-flex align-center mb-3 standfast-update-panel-header">
            <PersonAvatar Initials="@Participant.Initials" PhotoUrl="@PersonPhotoUrls.Saved(Participant.PersonId, Participant.PhotoSavedUtc)" Color="@StandFastTheme.ColumnColor(Participant.State)" IsRinged="true" Class="mr-3" />
            <div>
                <MudText Typo="Typo.h6">@Participant.DisplayName</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@Participant.Email</MudText>
            </div>
            @if (string.IsNullOrWhiteSpace(Participant.Notes))
            {
                <MudSpacer />
            }
            else
            {
                <div class="mx-4 standfast-person-notes">
                    <MarkdownView Value="@Participant.Notes" />
                </div>
            }
            <div class="standfast-update-panel-actions">
                @if (!IsReadOnly)
                {
                    <div>
                        <MarkdownSourceToggle @bind-ShowSource="isShowingSource" Target="all boxes" Size="Size.Medium" />
                        <MudTooltip Text="@CopyPriorDescription">
                            <MudButton Variant="Variant.Filled" Color="Color.Default" DropShadow="false" StartIcon="@Icons.Material.Filled.ContentCopy" Disabled="@(!CanCopyPriorForward)" OnClick="CopyPriorForward" aria-label="@CopyPriorDescription">Copy</MudButton>
                        </MudTooltip>
                    </div>
                }
                <div>
                    @if (!IsReadOnly)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" Disabled="@(!IsDirty || isSaving)" OnClick="SaveAsync">
                            @(isSaving ? "Saving..." : "Save")
                        </MudButton>
                    }
                    @if (CanCancel)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Default" DropShadow="false" StartIcon="@Icons.Material.Filled.Undo" OnClick="CancelEdits">Cancel</MudButton>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Default" DropShadow="false" StartIcon="@Icons.Material.Filled.Close" OnClick="OnClose">Close</MudButton>
                    }
                </div>
            </div>
        </div>
    }

    <MudGrid Spacing="3">
        @if (IsShown(EditorField.Update))
        {
            <MudItem xs="12" md="@ColumnWidth" Class="standfast-markdown-column">
                <MarkdownEditor Label="@LabelFor(EditorField.Update, UpdateLabel)"
                                @bind-Value="currentUpdate"
                                ReadOnly="@IsReadOnly"
                                Lines="@LinesFor(EditorField.Update)"
                                @bind-ShowSource="isShowingSource"
                                ShowSourceToggle="@IsExpanded(EditorField.Update)"
                                Expanded="@IsExpanded(EditorField.Update)"
                                ExpandedChanged="@(expanded => SetExpanded(EditorField.Update, expanded))"
                                Placeholder="@UpdatePlaceholder"
                                EmptyText="Nothing recorded for this date." />
            </MudItem>
        }

        @if (IsShown(EditorField.Blockers))
        {
            <MudItem xs="12" md="@ColumnWidth" Class="standfast-markdown-column">
                <MarkdownEditor Label="@LabelFor(EditorField.Blockers, "Blockers")"
                                @bind-Value="blockers"
                                ReadOnly="@IsReadOnly"
                                Lines="@LinesFor(EditorField.Blockers)"
                                @bind-ShowSource="isShowingSource"
                                ShowSourceToggle="@IsExpanded(EditorField.Blockers)"
                                Expanded="@IsExpanded(EditorField.Blockers)"
                                ExpandedChanged="@(expanded => SetExpanded(EditorField.Blockers, expanded))"
                                Placeholder="Anything in the way?"
                                EmptyText="No blockers recorded." />
            </MudItem>
        }

        @if (IsShown(EditorField.ParkingLot))
        {
            <MudItem xs="12" md="@ColumnWidth" Class="standfast-markdown-column">
                <MarkdownEditor Label="@LabelFor(EditorField.ParkingLot, "Parking lot")"
                                @bind-Value="parkingLot"
                                ReadOnly="@IsReadOnly"
                                Lines="@LinesFor(EditorField.ParkingLot)"
                                @bind-ShowSource="isShowingSource"
                                ShowSourceToggle="@IsExpanded(EditorField.ParkingLot)"
                                Expanded="@IsExpanded(EditorField.ParkingLot)"
                                ExpandedChanged="@(expanded => SetExpanded(EditorField.ParkingLot, expanded))"
                                Placeholder="Anything to take offline after the standup?"
                                EmptyText="Nothing parked." />
            </MudItem>
        }
    </MudGrid>

    @if (expandedField is null)
    {
        <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2">
            @(Participant.UpdateSavedUtc is null ? "Not saved yet." : $"Last saved {Participant.UpdateSavedUtc.ToLocalDisplay(TimeZone)}.")
        </MudText>
    }
</MudPaper>

@code {
    private const int ExpandedLines = 24;
    private const int GridColumns = 12;
    private const int SideBySideColumns = 3;

    private enum EditorField
    {
        Update,
        Blockers,
        ParkingLot,
    }

    private EditorField? expandedField;
    private string? currentUpdate;
    private string? blockers;
    private string? parkingLot;
    private Guid loadedPersonId;
    private DateOnly loadedDate;
    private bool isSaving;

    // One source-or-formatted state for all three boxes. An expanded box hides the panel header, so it shows its own toggle for the same state.
    private bool isShowingSource;

    private string CopyPriorDescription => CanCopyPriorForward
        ? "Copy the prior standup's update, blockers and parking lot into the empty boxes"
        : Participant.HasPrior
            ? "Nothing to copy: each box that has prior text to bring in already has text of its own. Clear a box to copy into it."
            : "Nothing to copy: no update, blockers or parking lot was recorded for this person at an earlier standup.";

    [Parameter]
    [EditorRequired]
    public BoardParticipantDto Participant { get; set; } = default!;

    [Parameter]
    public Guid StandupId { get; set; }

    [Parameter]
    public DateOnly MeetingDate { get; set; }

    [Parameter]
    public TimeZoneInfo TimeZone { get; set; } = TimeZoneInfo.Local;

    /// <summary>Set once the date has been closed, which leaves the panel as a way of reading what was recorded.</summary>
    [Parameter]
    public bool IsReadOnly { get; set; }

    [Parameter]
    public EventCallback<ParticipantUpdateDto> OnSave { get; set; }

    /// <summary>Raised when Close is picked, which is offered only while nothing in the panel is unsaved.</summary>
    [Parameter]
    public EventCallback OnClose { get; set; }

    [Inject]
    private IDialogService DialogService { get; set; } = default!;

    // Compared in stored form, since saving trims the text and the reloaded participant carries what was stored.
    private bool IsDirty => !OptionalText.Matches(currentUpdate, Participant.Update) || !OptionalText.Matches(blockers, Participant.Blockers) || !OptionalText.Matches(parkingLot, Participant.ParkingLot);

    // Cancel takes the place of Close while there are edits to throw away, so the panel only closes with nothing unsaved in it.
    private bool CanCancel => !IsReadOnly && IsDirty;

    private bool RecordsBlockersAndParkingLot => Participant.Kind.RecordsBlockersAndParkingLot();

    // Guests record notes only, so their single box takes the full width.
    private int ColumnWidth => expandedField is null && RecordsBlockersAndParkingLot ? GridColumns / SideBySideColumns : GridColumns;

    private string UpdateLabel => RecordsBlockersAndParkingLot ? "Current" : "Notes";

    private string UpdatePlaceholder => RecordsBlockersAndParkingLot ? "What did you do, what is next?" : "Anything to note?";

    private bool IsExpanded(EditorField field) => expandedField == field;

    private bool IsShown(EditorField field) => (field == EditorField.Update || RecordsBlockersAndParkingLot) && (expandedField is null || IsExpanded(field));

    private int LinesFor(EditorField field) => IsExpanded(field) ? ExpandedLines : MarkdownEditor.DefaultLines;

    // An expanded editor replaces the panel's header row, so its label carries the person's name.
    private string LabelFor(EditorField field, string label) => IsExpanded(field) ? $"{Participant.DisplayName} · {label}" : label;

    private void SetExpanded(EditorField field, bool expanded) => expandedField = expanded ? field : null;

    // Editing state is local so typing does not round-trip to storage, and is re-seeded whenever the panel switches person or date.
    protected override void OnParametersSet()
    {
        if (loadedPersonId == Participant.PersonId && loadedDate == MeetingDate)
        {
            return;
        }

        loadedPersonId = Participant.PersonId;
        loadedDate = MeetingDate;
        expandedField = null;
        currentUpdate = Participant.Update;
        blockers = Participant.Blockers;
        parkingLot = Participant.ParkingLot;
    }

    // Copying fills only boxes that are empty and have prior text, so nothing typed can be overwritten.
    private bool CanCopyPriorForward => Participant.HasPrior && (CanCopyInto(currentUpdate, Participant.PriorUpdate) || CanCopyInto(blockers, Participant.PriorBlockers) || CanCopyInto(parkingLot, Participant.PriorParkingLot));

    private static bool CanCopyInto(string? box, string? prior) => string.IsNullOrWhiteSpace(box) && !string.IsNullOrWhiteSpace(prior);

    private void CopyPriorForward()
    {
        currentUpdate = WithPrior(currentUpdate, Participant.PriorUpdate);
        blockers = WithPrior(blockers, Participant.PriorBlockers);
        parkingLot = WithPrior(parkingLot, Participant.PriorParkingLot);
    }

    /// <summary>The prior text under an italic line naming the standup it came from, for example "_Prior 7 Oct 2026 Wed:_", or the box unchanged when there is nothing to copy into it.</summary>
    private string? WithPrior(string? box, string? prior) => CanCopyInto(box, prior)
        ? $"{MarkdownCommands.ItalicMarker}Prior {Participant.PriorMeetingDate?.ToString(UiFormats.ShortDateWithWeekday)}:{MarkdownCommands.ItalicMarker}{MarkdownCommands.BlockSeparator}{prior!.Trim()}"
        : box;

    /// <summary>Asks before edits that have not been saved are lost. True when there is nothing unsaved or the reader agreed to discard it.</summary>
    public async Task<bool> ConfirmDiscardAsync()
    {
        if (!IsDirty)
        {
            return true;
        }

        bool? confirmed = await DialogService.ShowMessageBoxAsync(
            "Discard changes",
            $"Leave the update for {Participant.DisplayName} without saving? The changes typed here are lost.",
            yesText: "Discard",
            cancelText: "Keep editing");

        return confirmed == true;
    }

    /// <summary>Puts the boxes back to what is saved, leaving the panel open on the same person.</summary>
    private void CancelEdits()
    {
        currentUpdate = Participant.Update;
        blockers = Participant.Blockers;
        parkingLot = Participant.ParkingLot;
    }

    private async Task SaveAsync()
    {
        isSaving = true;

        try
        {
            await OnSave.InvokeAsync(new ParticipantUpdateDto
            {
                StandupId = StandupId,
                PersonId = Participant.PersonId,
                MeetingDate = MeetingDate,
                Update = currentUpdate,
                Blockers = blockers,
                ParkingLot = parkingLot,
            });
        }
        finally
        {
            isSaving = false;
        }
    }
}
