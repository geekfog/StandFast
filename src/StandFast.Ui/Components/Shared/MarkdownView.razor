@inject IMarkdownRenderer Markdown

@if (string.IsNullOrWhiteSpace(Value))
{
    <MudText Typo="Typo.body2" Class="mud-text-secondary">@EmptyText</MudText>
}
else
{
    <div class="standfast-markdown">@Markdown.ToHtml(Value, InteractiveTasks)</div>
}

@code {
    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public string EmptyText { get; set; } = "Nothing recorded.";

    /// <summary>Enables the task list checkboxes. The host handles their clicks; see <see cref="IMarkdownRenderer.ToggleTask"/>.</summary>
    [Parameter]
    public bool InteractiveTasks { get; set; }
}
