@inject ITaskService TaskService
@inject ITaskStateService TaskStateService
@inject IPersonService PersonService
@inject IDialogService DialogService
@using StandFast.Application.Mapping
@using StandFast.Application.Validation

@* Shaped like a markdown editor, with the same toolbar and scrolling body, so it lines up with the update boxes beside it. *@
<MudPaper Outlined="true" Class="standfast-markdown-editor standfast-task-list">
    <MudToolBar Dense="true" Gutters="false" Class="px-2 standfast-markdown-toolbar">
        <MudText Typo="Typo.subtitle2" Class="mr-2">@Label</MudText>
        <MudSpacer />
        <MudTooltip Text="@ShowDoneDescription">
            <MudToggleIconButton Toggled="showDone" ToggledChanged="@(toggled => showDone = toggled)" Icon="@TaskLabels.ShowDoneIcon" ToggledIcon="@TaskLabels.HideDoneIcon"
                                 ToggledColor="Color.Primary" Size="Size.Small" ToggledSize="Size.Small" aria-label="@ShowDoneDescription" />
        </MudTooltip>
        <MudTooltip Text="Add tasks">
            <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" Disabled="@(!CanAdd)" OnClick="@(() => EditAsync(null))" aria-label="Add tasks" />
        </MudTooltip>
        @if (ExpandedChanged.HasDelegate)
        {
            <MudTooltip Text="@ExpandTooltip">
                <MudIconButton Icon="@(Expanded ? Icons.Material.Filled.Close : Icons.Material.Filled.OpenInFull)" Size="Size.Small" OnClick="@(() => ExpandedChanged.InvokeAsync(!Expanded))" aria-label="@ExpandTooltip" />
            </MudTooltip>
        }
    </MudToolBar>

    <div class="standfast-markdown-body">
        @if (isLoading)
        {
            <MudProgressLinear Indeterminate="true" />
        }
        else if (list is null)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary pa-3">@ValidationMessages.TaskOwnerNotFound</MudText>
        }
        else if (states.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary pa-3">
                No task states are defined yet. Add them under <MudLink Href="@UiRoutes.Organization">@CalendarLabels.Organization</MudLink>, on the @TaskLabels.TaskStates tab.
            </MudText>
        }
        else
        {
            <MudDataGrid T="TaskRow" Items="@ShownRows" Dense="true" Hover="true" Elevation="0" Square="true" Class="standfast-task-grid"
                         ColumnResizeMode="ResizeMode.Column" SortMode="SortMode.Multiple" Filterable="true" FilterMode="DataGridFilterMode.ColumnFilterMenu">
                <Columns>
                    <PropertyColumn Property="row => row.State" Title="@TaskLabels.State" HeaderClass="@ChipColumn">
                        <CellTemplate>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@TaskLabels.GroupColor(context.Item.Task.StateGroup)" Class="ma-0">@context.Item.State</MudChip>
                        </CellTemplate>
                    </PropertyColumn>
                    @if (Detailed)
                    {
                        <PropertyColumn Property="row => row.Grouping" Title="@TaskLabels.Grouping" HeaderClass="@GroupingColumn" />
                    }
                    <PropertyColumn Property="row => row.Priority" Title="@TaskLabels.Priority" HeaderClass="@NumberColumn" />
                    <PropertyColumn Property="row => row.Title" Title="@TaskLabels.Title">
                        <CellTemplate>
                            <MudLink Typo="Typo.body2" OnClick="@(() => EditAsync(context.Item.Task))" title="@context.Item.Title">@context.Item.Title</MudLink>
                        </CellTemplate>
                    </PropertyColumn>
                    <PropertyColumn Property="row => row.Date" Title="@TaskLabels.DateColumn(showDone)" HeaderClass="@DateColumn">
                        <CellTemplate>
                            @if (context.Item.DueAheadOfMoreUrgent > 0)
                            {
                                <span class="standfast-task-date-conflict" title="@TaskLabels.DueAheadOfMoreUrgent(context.Item.DueAheadOfMoreUrgent)">@DateText(context.Item.Date)</span>
                            }
                            else
                            {
                                @DateText(context.Item.Date)
                            }
                        </CellTemplate>
                    </PropertyColumn>
                    @if (Detailed)
                    {
                        <PropertyColumn Property="row => row.RequestedBy" Title="@TaskLabels.RequestedBy" HeaderClass="@PersonColumn">
                            <CellTemplate>
                                <span title="@context.Item.RequestedBy">@context.Item.RequestedBy</span>
                            </CellTemplate>
                        </PropertyColumn>
                        <PropertyColumn Property="row => row.Created" Title="@TaskLabels.Created" Format="@UiFormats.ShortDate" HeaderClass="@DateColumn" />
                    }
                </Columns>
                <NoRecordsContent>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">@EmptyText</MudText>
                </NoRecordsContent>
            </MudDataGrid>
        }
    </div>
</MudPaper>

@code {
    private const string Label = TaskLabels.Tasks;

    /// <summary>Starting widths for every column but the title, which resizing overrides; the title takes what is left.</summary>
    private const string ChipColumn = "standfast-task-col-chip";
    private const string GroupingColumn = "standfast-task-col-grouping";
    private const string NumberColumn = "standfast-task-col-number";
    private const string DateColumn = "standfast-task-col-date";
    private const string PersonColumn = "standfast-task-col-person";

    private TaskListDto? list;
    private IReadOnlyList<TaskStateDto> states = [];
    private IReadOnlyList<PersonDto> people = [];
    private IReadOnlyList<TaskRow> openRows = [];
    private IReadOnlyList<TaskRow> doneRows = [];
    private bool isLoading = true;
    private bool showDone;

    /// <summary>The signed-in user's settings, loaded once by the layout, whose address picks which list is shown.</summary>
    [CascadingParameter]
    private UserPreferencesDto Preferences { get; set; } = UserPreferencesDto.Default;

    /// <summary>Adds the grouping, requester, and created date for the Tasks page; the board's panel leaves them out to stay narrow.</summary>
    [Parameter]
    public bool Detailed { get; set; }

    /// <summary>The time zone a task's created date and a done task's last update are dated in.</summary>
    [Parameter]
    public TimeZoneInfo TimeZone { get; set; } = TimeZoneInfo.Local;

    [Parameter]
    public bool Expanded { get; set; }

    [Parameter]
    public EventCallback<bool> ExpandedChanged { get; set; }

    /// <summary>Open tasks, or only done ones while the toggle is on, each in the order the list arrives in until a column is sorted.</summary>
    private IReadOnlyList<TaskRow> ShownRows => showDone ? doneRows : openRows;

    private bool CanAdd => list is not null && states.Count > 0;

    private string ShowDoneDescription => showDone ? "Show open tasks" : "Show done tasks";

    private string ExpandTooltip => Expanded ? "Close the expanded view" : "Expand";

    private string EmptyText => showDone ? "No done tasks." : list?.Tasks.Count > 0 ? "Every task is done. Show done tasks to list them." : "No tasks yet.";

    protected override Task OnInitializedAsync() => ReloadAsync();

    private async Task ReloadAsync()
    {
        isLoading = true;
        (list, states, people) = (await TaskService.GetForOwnerAsync(Preferences.Email), await TaskStateService.GetAllAsync(), await PersonService.GetAllAsync());
        IReadOnlyDictionary<Guid, int> conflicts = list?.Tasks.DueAheadOfMoreUrgent() ?? new Dictionary<Guid, int>();
        TaskRow[] rows = [.. list?.Tasks.Select(task => ToRow(task, conflicts.GetValueOrDefault(task.Id))) ?? []];
        (openRows, doneRows) = ([.. rows.Where(row => !row.Task.IsDone)], [.. rows.Where(row => row.Task.IsDone)]);
        isLoading = false;
    }

    /// <summary>A done task is dated by its last update, which is when it was done; an open one by its due date.</summary>
    private TaskRow ToRow(WorkTaskDto task, int dueAheadOfMoreUrgent) => new(
        task,
        task.StateTitle ?? UiFormats.UnavailableSymbol,
        task.StateGroup is { } group ? TaskLabels.GroupName(group) : UiFormats.UnavailableSymbol,
        task.Priority,
        task.Title,
        task.IsDone ? LocalDate(task.LastUpdatedUtc) : task.DueDate?.ToDateTime(TimeOnly.MinValue),
        people.FirstOrDefault(person => person.Id == task.RequestedByPersonId)?.DisplayName ?? TaskLabels.RequesterRemoved,
        LocalDate(task.CreatedUtc),
        dueAheadOfMoreUrgent);

    private DateTime LocalDate(DateTimeOffset moment) => TimeZoneInfo.ConvertTime(moment, TimeZone).Date;

    private static string DateText(DateTime? date) => date?.ToString(UiFormats.ShortDate) ?? string.Empty;

    /// <summary>A new task starts in the first state listed and is requested by the signed-in user, who can pick someone else.</summary>
    private async Task EditAsync(WorkTaskDto? task)
    {
        if (list is null)
        {
            return;
        }

        WorkTaskEditDto edit = task?.ToEditDto() ?? new WorkTaskEditDto { StateId = states.FirstOrDefault()?.Id, RequestedByPersonId = list.OwnerPersonId };
        DialogParameters<TaskDialog> parameters = new()
        {
            { dialog => dialog.Item, edit },
            { dialog => dialog.OwnerEmail, Preferences.Email },
            { dialog => dialog.States, states },
            { dialog => dialog.People, people },
        };

        IDialogReference reference = await DialogService.ShowAsync<TaskDialog>(null, parameters);
        if (!(await reference.Result)!.Canceled)
        {
            await ReloadAsync();
        }
    }

    /// <summary>One grid row: a task with each column's value worked out once, so every column sorts and filters on what it shows.</summary>
    /// <param name="DueAheadOfMoreUrgent">How many more urgent open tasks are due after this one, which highlights its date when above zero.</param>
    private sealed record TaskRow(WorkTaskDto Task, string State, string Grouping, int Priority, string Title, DateTime? Date, string RequestedBy, DateTime Created,
        int DueAheadOfMoreUrgent);
}
