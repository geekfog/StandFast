<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <UserSecretsId>standfast-ui-8c1f0f9a</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <ApplicationIcon>$(BrandingIconIco)</ApplicationIcon>
  </PropertyGroup>

  <!-- The icon artwork is served from media at the site root under its own file names, which AppInfo refers to. Without ContentRoot, development serves a linked file from wwwroot, where it does not exist. -->
  <ItemGroup>
    <Content Include="$(BrandingIconSvg);$(BrandingIconIco);$(BrandingIconPng)" Link="wwwroot\%(Filename)%(Extension)" ContentRoot="$(BrandingDirectory)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Blobs" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
    <PackageReference Include="MudBlazor" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.AzureTableStorage" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StandFast.Application\StandFast.Application.csproj" />
    <ProjectReference Include="..\StandFast.Infrastructure\StandFast.Infrastructure.csproj" />
  </ItemGroup>

</Project>
